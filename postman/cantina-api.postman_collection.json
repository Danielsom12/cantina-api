    {
      "name": "08 - Atualizar produto (nome e preco)",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/produtos/{{produtoId}}",
          "host": [
            "{{baseUrl}}"
          ],
