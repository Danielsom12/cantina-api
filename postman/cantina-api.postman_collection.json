            "999999"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 - nao encontrado\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Cadastrar produto",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Pastel de queijo\",\n  \"preco\": 8.5,\n  \"estoque\": 3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 - criado\", () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.collectionVariables.set(\"produtoId\", p.id);",
              "pm.test(\"Dados gravados\", () => { pm.expect(p.preco).to.eql(8.5); pm.expect(p.estoque).to.eql(3); });"
            ]
          }
        }
      ]
    },
