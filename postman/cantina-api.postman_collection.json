      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 - pedido criado\", () => pm.response.to.have.status(201));",
              "const ped = pm.response.json();",
              "pm.collectionVariables.set(\"pedidoId\", ped.id);",
              "pm.test(\"Preco registrado = preco atual (9.00)\", () => pm.expect(ped.precoRegistrado).to.eql(9));",
              "pm.test(\"Situacao ATIVO\", () => pm.expect(ped.situacao).to.eql(\"ATIVO\"));"
            ]
          }
        }
      ]
    },
