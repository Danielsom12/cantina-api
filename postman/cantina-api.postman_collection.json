      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 - atualizado\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nome e preco alterados\", () => { const p = pm.response.json(); pm.expect(p.nome).to.eql(\"Pastel de queijo grande\"); pm.expect(p.preco).to.eql(9); });"
            ]
          }
