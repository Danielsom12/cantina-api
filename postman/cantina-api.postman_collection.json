{
  "info": {
    "name": "Cantina API - AVC 2026/2",
    "description": "Coleção do grupo (provisória até a coleção oficial ser disponibilizada). Execute na ordem, com o banco recém-criado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "produtoTempId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Listar clientes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 - lista\", () => pm.response.to.have.status(200));",
              "pm.test(\"Retorna array com clientes\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar cliente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/clientes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "1"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 - encontrado\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cliente 1\", () => pm.expect(pm.response.json().id).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar cliente inexistente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/clientes/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
